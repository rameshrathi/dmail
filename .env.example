# Environment Configuration for Local Development (DMN)
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL

# PostgreSQL Database
POSTGRES_DB=dmn_dev
POSTGRES_USER=dmn_admin
POSTGRES_PASSWORD=dev_postgres_password_change_in_prod
POSTGRES_PORT=5432

# MinIO S3-Compatible Object Store
MINIO_ROOT_USER=minio_dev_admin
MINIO_ROOT_PASSWORD=dev_minio_password_change_in_prod
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKETS=dmn-encrypted-objects

# Stalwart Mail Server
STALWART_SMTP_PORT=2525
STALWART_SUBMISSION_PORT=2587
STALWART_IMAP_PORT=2993
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=dev_stalwart_password_change_in_prod
